# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by the seed script (bypasses RLS). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
# R2 → Manage R2 API Tokens (S3-compatible). All server-only except the public URL.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=noblelift
# Public base URL for serving uploads: the r2.dev domain or your custom domain.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-XXXXXXXX.r2.dev
